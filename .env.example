# Canonical base URL for this deployment. Cloudflare Pages sets it per
# environment so preview builds never emit production canonicals.
PUBLIC_SITE_URL="https://freelance-money-calculator.pages.dev"

# Whether search engines may index this deployment.
# Unset or "false": every page emits noindex, robots.txt disallows everything,
# and no sitemap is published. Set to "true" only on the final domain.
PUBLIC_INDEXABLE="false"

# Ads stay off until the AdSense prerequisites in CLAUDE.md are met.
PUBLIC_ADS_ENABLED="false"
