---
import type { Locale } from '../../lib/constants';
import { DEFAULT_LOCALE } from '../../lib/constants';
import { INDEXABLE } from '../../lib/site';

/**
 * Every indexable page renders exactly one of these. Centralizing metadata is
 * what stops a page shipping months from now with a duplicated title or a
 * missing canonical — failures invisible in the browser that only show up as
 * lost rankings.
 */
export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  alternates: Record<Locale, string>;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, locale, path, alternates, ogImage, jsonLd = [], noindex: pageNoindex = false } = Astro.props;

// A page is noindex either because it asks to be (a draft, a 404) or because
// the whole deployment is not meant to be indexed yet — a test deployment on a
// temporary hostname, for instance.
const noindex = pageNoindex || !INDEXABLE;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? Astro.site?.toString() ?? '';
const abs = (p: string) => new URL(p, siteUrl).toString();
const canonical = abs(path);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

{/*
  hreflang must be reciprocal and absolute, or search engines ignore it entirely.
  A noindex page is deliberately excluded: it cannot be part of an hreflang
  cluster, because the indexed pages in that cluster will not link back to it.
*/}
{!noindex && (
  <>
    {Object.entries(alternates).map(([loc, p]) => (
      <link rel="alternate" hreflang={loc} href={abs(p)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(alternates[DEFAULT_LOCALE])} />
  </>
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Freelance Money Calculator" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale} />
{ogImage && <meta property="og:image" content={abs(ogImage)} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

{/* Invalid JSON-LD fails silently, which is why the audit script parses every block. */}
{jsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
