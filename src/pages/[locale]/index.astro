---
import type { Locale } from '../../lib/constants';
import { LOCALES } from '../../lib/constants';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { t } from '../../i18n/utils';
import { listedTools, toolPath } from '../../lib/registry';
import { INDEXABLE } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const alternates = { en: '/en/', es: '/es/' };

const visibleTools = listedTools(!INDEXABLE);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t(locale, 'site.name'),
    url: import.meta.env.PUBLIC_SITE_URL ?? Astro.site?.toString(),
    inLanguage: locale,
  },
];
---
<BaseLayout
  locale={locale}
  title={t(locale, 'site.metaTitle')}
  description={t(locale, 'site.metaDescription')}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <h1 class="text-3xl font-bold tracking-tight">{t(locale, 'home.heading')}</h1>
  <p class="mt-4 text-lg" style="color: var(--color-ink-muted)">{t(locale, 'home.intro')}</p>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">{t(locale, 'home.toolsHeading')}</h2>
    {visibleTools.length === 0 ? (
      <p class="mt-3" style="color: var(--color-ink-muted)">{t(locale, 'home.emptyState')}</p>
    ) : (
      <ul class="mt-4 grid gap-4">
        {visibleTools.map((tool) => (
          <li class="rounded-lg border p-4" style="border-color: var(--color-border)">
            <a href={toolPath(tool, locale)} class="font-medium">{t(locale, `${tool.id}.title`)}</a>
            <p class="mt-1 text-sm" style="color: var(--color-ink-muted)">
              {t(locale, `${tool.id}.shortDescription`)}
            </p>
          </li>
        ))}
      </ul>
    )}
  </section>

  <AdSlot height={250} label={t(locale, 'common.advertisement')} />
</BaseLayout>
